
android_ab_slot=
androidboot_recovery=0
baudrate=921600
bootcmd=run mmcboot
bootdelay=2
dtb_index=0
dtbo_index=1
kerneladdr=0x4A000000
loadaddr=0x50000000
mmcboot=if bcb load ${mmcdev} misc; then if bcb test command = boot-recovery; then bcb clear command; bcb store;aprop load ${mmcdev} userdata;if aprop test persist.sys.boot.reason = recovery; then aprop set persist.sys.boot.reason none; aprop store;fi;setenv androidboot_recovery 1;else if aprop load ${mmcdev} userdata; then if aprop test persist.sys.boot.reason = recovery; then aprop set persist.sys.boot.reason none; aprop store;setenv androidboot_recovery 1;fi;fi;fi;fi;if test "${androidboot_recovery}" -eq 1; then echo Android: booting into recovery;part start mmc ${mmcdev} dtbo dtbo_part_start;part size mmc ${mmcdev} dtbo dtbo_part_size;mmc read ${loadaddr} ${dtbo_part_start} ${dtbo_part_size};dtimg select ${loadaddr} ${dtb_index};dtimg merge ${loadaddr} ${dtbo_index};part start mmc ${mmcdev} recovery recovery_part_start;part size mmc ${mmcdev} recovery recovery_part_size;mmc read ${loadaddr} ${recovery_part_start} ${recovery_part_size};bootm ${loadaddr};fi;echo Android: booting into system;part start mmc ${mmcdev} dtbo dtbo_part_start;part size mmc ${mmcdev} dtbo dtbo_part_size;mmc read ${loadaddr} ${dtbo_part_start} ${dtbo_part_size};dtimg select ${loadaddr} ${dtb_index};dtimg merge ${loadaddr} ${dtbo_index};part start mmc ${mmcdev} boot boot_part_start;part size mmc ${mmcdev} boot boot_part_size;mmc read ${loadaddr} ${boot_part_start} ${boot_part_size};part number-format dec;part number mmc ${mmcdev} system rootfs_partition;setenv bootargs  "${bootargs} root=/dev/mmcblk${mmcdev}p${rootfs_partition}";setenv bootargs  "${bootargs} androidboot.android_dt_dir=/proc/device-tree/odm/firmware/android/";bootm ${loadaddr};
mmcdev=0
rootfs_partition=0
