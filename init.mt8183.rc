on init
   start watchdogd

on fs
    mount_all /vendor/etc/fstab.mt8183
    start console

on post-fs-data
    setprop vold.post_fs_data_done 1

on early-boot
    # backlight
    chown system system /sys/class/backlight/odm:backlight_lcd0/brightness

service watchdogd /sbin/watchdogd 10 20
    class core
    oneshot
    seclabel u:r:watchdogd:s0
