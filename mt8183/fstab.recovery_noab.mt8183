# Android fstab file.
# <src>						<mnt_point>   <type>  <mnt_flags and options>  <fs_mgr_flags>
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

/dev/block/platform/soc/11230000.mmc/by-name/system		/               ext4	noatime,nosuid,nodev	wait,check,quota
/dev/block/platform/soc/11230000.mmc/by-name/vendor		/vendor		ext4	noatime,nosuid,nodev	wait,check,quota
/dev/block/platform/soc/11230000.mmc/by-name/userdata		/data		ext4	noatime,nosuid,nodev	wait,check,quota
/dev/block/platform/soc/11230000.mmc/by-name/cache		/cache		ext4	noatime,nosuid,nodev	wait,check,quota
/dev/block/platform/soc/11230000.mmc/by-name/boot		/boot		emmc	defaults	defaults
/dev/block/platform/soc/11230000.mmc/by-name/dtbo		/dtbo		emmc	defaults	defaults
/dev/block/platform/soc/11230000.mmc/by-name/misc		/misc		emmc	defaults	defaults
