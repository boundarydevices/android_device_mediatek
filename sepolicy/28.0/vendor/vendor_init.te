typeattribute vendor_init data_between_core_and_vendor_violators;

allow vendor_init vendor_file:system { module_load };
allow vendor_init self:capability { sys_module };
allow vendor_init kernel:system module_request;
allow vendor_init kernel:key { write search };
allow vendor_init init:key write;
allow vendor_init vendor_init:key write;
allow vendor_init device:file { create write };

allow vendor_init file_contexts_file:file r_file_perms;

allow vendor_init {
    audio_data_file
    bluetooth_data_file
    camera_data_file
    dhcp_data_file
    media_rw_data_file
    nfc_data_file
    radio_data_file
    system_data_file
    tombstone_data_file
    wifi_data_file
}:dir create_dir_perms;

allow vendor_init proc:file write;
allow vendor_init unlabeled:dir { r_dir_perms setattr relabelfrom };
allow vendor_init unlabeled:file { r_file_perms setattr relabelfrom };
allow vendor_init mnt_vendor_file:lnk_file r_file_perms;
allow vendor_init vendor_toolbox_exec:file rx_file_perms;

userdebug_or_eng(`
    allow vendor_init shell_prop:property_service set;
')

set_prop(vendor_init, exported_system_prop)
set_prop(vendor_init, ffs_prop)
set_prop(vendor_init, public_vendor_default_prop)

r_dir_file(vendor_init, cgroup)

recovery_only(`
    allow vendor_init rootfs:system module_load;
    allow vendor_init rootfs:file r_file_perms;
')
