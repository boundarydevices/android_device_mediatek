# Gatekeeper HAL
/vendor/bin/hw/android\.hardware\.gatekeeper@1\.0-service\.software	u:object_r:hal_gatekeeper_default_exec:s0

# custom lights HAL (backlight)
/vendor/bin/hw/android\.hardware\.lights-service\.mediatek              u:object_r:hal_light_default_exec:s0

# vpud (media encoding/decoding using HW accelerators)
/vendor/bin/vpud\.mt[0-9]*                                          u:object_r:vpud_exec:s0

/dev/vpu                                                            u:object_r:vpu_device:s0

# graphics
/dev/dri/card[0-9]*                                 u:object_r:graphics_device:s0

# devices
/dev/block/zram0				    u:object_r:swap_block_device:s0

# Libraries
/vendor/lib(64)?/libdrm\.so                         u:object_r:same_process_hal_file:s0

# sysfs files
/sys/devices/platform/backlight_lcd0/backlight(/.*)?                u:object_r:sysfs_leds:s0

# drm
/vendor/bin/hw/android\.hardware\.drm@[0-9]+\.[0-9]+-service\.clearkey     u:object_r:hal_drm_clearkey_exec:s0
/data/vendor/mediadrm(/.*)?    u:object_r:mediadrm_vendor_data_file:s0
