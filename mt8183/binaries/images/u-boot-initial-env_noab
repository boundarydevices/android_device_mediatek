

baudrate=921600
bootcmd=run distro_bootcmd
bootcmd= run mmcboot
bootdelay=2
dtbaddr=0x54000000
dtb_index=0
dtboaddr=0x54C00000
dtbo_index=0
fastboot=fastboot usb 0
fdt_addr_r=0x56000000
fdt_size=0xC0000
 hardware=mt8183
loadaddr=0x50000000
mmcboot=mmc dev ${mmcdev}; if bcb load 0 misc; then if bcb test command = bootonce-bootloader; then echo BCB: Bootloader boot...; bcb clear command; bcb store; run fastboot; exit; elif bcb test command = boot-recovery; then echo BCB: Recovery boot...; bcb clear command; bcb store; setenv apart recovery${slot_suffix}; else echo BCB: Normal boot requested...; setenv apart boot${slot_suffix}; fi; else echo Warning: BCB is corrupted or does not exist; echo Performing normal boot...; fi; setenv avb_verify "avb init 0; avb verify ${slot_suffix};"; if run avb_verify; then echo AVB verification OK.; setenv bootargs "$bootargs $avb_bootargs"; else setenv bootargs "$bootargs androidboot.verifiedbootstate=orange"; echo AVB verification failed.; fi; part start mmc ${mmcdev} ${apart} boot_start;part size mmc ${mmcdev} ${apart} boot_size;if mmc read ${loadaddr} ${boot_start} ${boot_size}; then echo ${apart} paritition loaded into memory...; else echo Failed to load ${apart} partition...; reset; fi;echo Preparing FDT...; abootimg get dtb --index=$dtb_index dtb_start dtb_size; cp.b $dtb_start $fdt_addr_r $dtb_size; fdt addr $fdt_addr_r $fdt_size; part start mmc ${mmcdev} dtbo${slot_suffix} dtbo_start; part size mmc ${mmcdev} dtbo${slot_suffix} dtbo_size; mmc read ${dtboaddr} ${dtbo_start} ${dtbo_size}; echo "  Applying DTBOs..."; adtimg addr $dtboaddr; dtbo_idx=''; for index in $dtbo_index; do adtimg get dt --index=$index dtbo_addr; fdt apply $dtbo_addr; if test $dtbo_idx = ''; then dtbo_idx=${index}; else dtbo_idx=${dtbo_idx},${index}; fi; done; setenv bootargs "$bootargs androidboot.dtbo_idx=$dtbo_idx "; setenv bootargs "$bootargs androidboot.serialno=${serial#} "; setenv bootargs "$bootargs androidboot.hardware=${hardware} "; bootm ${loadaddr} ${loadaddr} ${fdt_addr_r}; 
mmcdev=0
serial#=pumpkin-i500-12345
