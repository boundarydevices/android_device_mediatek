
baudrate=921600
bootargs= console=tty0 console=ttyS0,921600n1 earlycon=uart8250,mmio32,0x11002000
bootcmd=run distro_bootcmd
bootcmd=run mmcboot
bootdelay=2
dtb_index=0
dtbo_index=1
kerneladdr=0x4A000000
loadaddr=0x50000000
load_bootimg=part start mmc ${mmcdev} boot boot_part_start;part size mmc ${mmcdev} boot boot_part_size;mmc read ${loadaddr} ${boot_part_start} ${boot_part_size}; 
load_dtb=part start mmc ${mmcdev} dtbo dtbo_part_start;part size mmc ${mmcdev} dtbo dtbo_part_size;mmc read ${loadaddr} ${dtbo_part_start} ${dtbo_part_size};dtimg select ${loadaddr} ${dtb_index};dtimg merge ${loadaddr} ${dtbo_index}; 
load_recoveryimg=part start mmc ${mmcdev} recovery recovery_part_start;part size mmc ${mmcdev} recovery recovery_part_size;mmc read ${loadaddr} ${recovery_part_start} ${recovery_part_size}; 
load_splashscreen=part start mmc ${mmcdev} splashscreen splashscreen_part_start;mmc read ${splashscreen_loadaddr} ${splashscreen_part_start} 0x3fc0;splashscreen;
mmcboot=run load_splashscreen;if bcb load ${mmcdev} misc; then if bcb test command = boot-recovery; then bcb clear command; bcb store;aprop load ${mmcdev} userdata;if aprop test persist.sys.boot.reason = recovery; then aprop set persist.sys.boot.reason none; aprop store;fi;run load_dtb;run load_recoveryimg;bootm ${loadaddr};fi;fi;if aprop load ${mmcdev} userdata; then if aprop test persist.sys.boot.reason = recovery; then aprop set persist.sys.boot.reason none; aprop store;run load_dtb;run load_recoveryimg;bootm ${loadaddr};fi;fi;run load_dtb;run load_bootimg;bootm ${loadaddr}; 
 mmcdev=0
splashscreen_loadaddr=0x60000000
