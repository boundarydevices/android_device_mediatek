recovery_only(`
    # Sideload cache
    allow recovery proc_meminfo:file r_file_perms;

    allow recovery sysfs:file w_file_perms;
    allow recovery sysfs:dir r_dir_perms;
    allow recovery system_data_file:file r_file_perms;

    allow recovery cache_file:dir mounton;
    allow recovery tmpfs:dir mounton;
    allow recovery tmpfs:file link;
    r_dir_file(recovery, media_rw_data_file)
    r_dir_file(recovery, sdcard_type)

    allow recovery system_data_file:dir r_dir_perms;
    allow recovery rootfs:dir create_dir_perms;

    allow recovery self:capability sys_rawio;
    set_prop(recovery, ffs_prop)

    allow recovery proc_filesystems:file r_file_perms;
    allow recovery block_device:dir create_dir_perms;
    allow recovery block_device:blk_file { create rw_file_perms };
    dontaudit recovery device:chr_file rw_file_perms;
    get_prop(recovery, bluetooth_a2dp_offload_prop);
    get_prop(recovery, bluetooth_prop);
    get_prop(recovery, boottime_prop);
    get_prop(recovery, ctl_bootanim_prop);
    get_prop(recovery, ctl_bugreport_prop);
    get_prop(recovery, ctl_console_prop);
    get_prop(recovery, ctl_dumpstate_prop);
    get_prop(recovery, ctl_fuse_prop);
    get_prop(recovery, ctl_interface_restart_prop);
    get_prop(recovery, ctl_interface_start_prop);
    get_prop(recovery, ctl_interface_stop_prop);
    get_prop(recovery, ctl_mdnsd_prop);
    get_prop(recovery, ctl_restart_prop);
')
