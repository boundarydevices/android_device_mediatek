allow platform_app vendor_file:file r_file_perms;
allow platform_app system_app_data_file:file {read write};

allow platform_app platform_app:icmp_socket create;
dontaudit platform_app property_type:file *;

allow platform_app platform_app:icmp_socket create_socket_perms;
