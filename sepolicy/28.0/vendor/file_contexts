# custom health HAL (batteryless)
/vendor/bin/hw/android\.hardware\.health@2\.0-service\.batteryless u:object_r:hal_health_default_exec:s0

# custom lights HAL (backlight)
/vendor/bin/hw/android\.hardware\.light@2\.0-service\.mediatek u:object_r:hal_light_default_exec:s0

# audio hal
/vendor/bin/hw/android\.hardware\.audio@4\.0-service\.mediatek u:object_r:hal_audio_default_exec:s0

# Vendor firmwares
/(vendor|system/vendor)/firmware(/.*)?              u:object_r:vendor_firmware_file:s0

# graphics
/dev/dri/card[0-9]*                                 u:object_r:graphics_device:s0
