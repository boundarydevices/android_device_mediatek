soong_namespace {
}

cc_prebuilt_binary {
    name: "vpud.mt8167",
    srcs: ["bin/vpud"],
    shared_libs: [
        "libc++",
        "libc",
        "libcutils",
        "libdl",
        "liblog",
        "libm",
        "libutils",
        "libvcodec_utility",
        "libvpud_vcodec",
        "libherope_sa.ca7",
    ],
    strip: {
        none: true,
    },
    compile_multilib: "32",
    vendor: true,
    init_rc: ["etc/init.vpud.mt8167.rc"],
}

cc_prebuilt_library_shared {
    name: "libherope_sa.ca7",
    srcs: ["lib/libherope_sa.ca7.so"],
    shared_libs: [
        "libc++",
        "libc",
        "libcutils",
        "libdl",
        "liblog",
        "libm",
        "libvcodec_oal",
        "libvcodec_utility",
    ],
    strip: {
        none: true,
    },
    compile_multilib: "32",
    vendor: true,
    allow_undefined_symbols: true,
}

