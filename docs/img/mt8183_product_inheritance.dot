// .INHERITS_FROM (can also be used instead)

digraph G
{
  node [shape=plaintext]
  subgraph cluster_01 {
    label = "Legend";
    key [label=<<table border="0" cellpadding="2" cellspacing="0" cellborder="0">
         <tr><td align="right" port="i1">mandatory</td></tr>
         <tr><td align="right" port="i2">optional</td></tr>
         </table>>]
    key2 [label=<<table border="0" cellpadding="2" cellspacing="0" cellborder="0">
          <tr><td port="i1">&nbsp;</td></tr>
          <tr><td port="i2">&nbsp;</td></tr>
          </table>>]
    key:i1:e -> key2:i1:w [style=solid]
    key:i2:e -> key2:i2:w [style=dotted]
    { rank="same" key:i1:e key2:i1:w }
  }

  edge [dir=back];

  // mediatek node definition (yellow)
  node [color="#b58900", style=filled, fontcolor="#fdf6e3", shape="rectangle"];
  "mt8183.mk";
  device_mk_8183 [label="device.mk"];

  // AOSP node definition (green)
  node [color="#859900", style=filled, fontcolor="#fdf6e3", shape="rectangle"];
  "core_64_bit.mk";
  "aosp_base.mk";
  "full_base.mk";
  "frameworks/\nbase/\ndata/\nsounds/\nAllAudio.mk";
  "languages_full.mk";
  "generic_no_telephony.mk";
  "vendor/\ngoogle/\nsecurity/\nadb/\nvendor_key.mk";
  all_fonts [shape=tab label="ALL FONTS\n
frameworks/base/data/fonts/fonts.mk
external/google-fonts/dancing-script/fonts.mk
external/google-fonts/carrois-gothic-sc/fonts.mk
external/google-fonts/coming-soon/fonts.mk
external/google-fonts/cutive-mono/fonts.mk
external/noto-fonts/fonts.mk
external/roboto-fonts/fonts.mk
external/hyphenation-patterns/patterns.mk
frameworks/base/data/keyboards/keyboards.mk
frameworks/webview/chromium/chromium.mk"];
  "core.mk";
  "core_base.mk";
  "core_minimal.mk"
  "runtime_libart.mk";
  "base.mk";
  "cfi-common.mk";
  "vendor/\ngoogle/\nproducts/\ncfi-vendor.mk";
  "embedded.mk";

  "mt8183.mk" -> "core_64_bit.mk";
  "mt8183.mk" -> "aosp_base.mk";
  "mt8183.mk" -> device_mk_8183;

  // ---------------------------
  // all core_64_bit.mk deps: <none>, stuff for 64 bits apps
  // all aosp_base.mk deps
  "aosp_base.mk" -> "full_base.mk";

  // ---------------------------
  // all full_base.mk deps
  "full_base.mk" -> "frameworks/\nbase/\ndata/\nsounds/\nAllAudio.mk" [style="dotted"];
  "full_base.mk" -> "languages_full.mk";
  "full_base.mk" -> "generic_no_telephony.mk";
  "full_base.mk" -> "vendor/\ngoogle/\nsecurity/\nadb/\nvendor_key.mk" [style="dotted"];

  // ---------------------------
  // all AllAudio.mk deps:  <none>, just audio effects (.ogg files)
  // all languages_full.mk deps: <none>, just a list of languages
  // all generic_no_telephony deps

  "generic_no_telephony.mk" -> all_fonts [style="dashed"];
  "generic_no_telephony.mk" -> "core.mk";

  // all vendor_key.mk deps: <none>, no vendor folder

  // ---------------------------
  // all frameworks fonts deps: <none>, just fonts
  // all dancing fonts deps: <none>, just fonts
  // all gothic fonts deps: <none>, just fonts
  // all coming soon fonts deps: <none>, just fonts
  // all cutive mono fonts deps: <none>, just fonts
  // all roboto fonts deps: <none>, just fonts
  // all patterns deps: <none>, just hyphenation patterns for languages
  // all keyboards deps: <none>, just keyboard layouts
  // all chromium deps: <none>, file does not exist
  // all core.mk deps
  "core.mk" -> "core_base.mk";

  // ---------------------------
  // all core_base.mk deps
  "core_base.mk" -> "core_minimal.mk";

  // ---------------------------
  // all core_minimal.mk deps
  "core_minimal.mk" -> "runtime_libart.mk";
  "core_minimal.mk" -> "base.mk";
  "core_minimal.mk" -> "cfi-common.mk";
  "core_minimal.mk" -> "vendor/\ngoogle/\nproducts/\ncfi-vendor.mk" [style="dotted"];

  // ---------------------------
  // all runtime_libart.mk deps: <none>, just a bunch of ART stuff
  // all base.mk deps
  "base.mk" -> "embedded.mk";
  // all cfi-common.mk deps: <none>, just a list of CFI paths
  // all cfi-vendor.mk deps: <none>, file does not exist

  // ---------------------------
  // all "embbeded.mk" deps -> none, we are done
}
