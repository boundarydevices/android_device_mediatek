typeattribute init data_between_core_and_vendor_violators;

allow init tmpfs:lnk_file create;
allow init nativetest_data_file:dir r_dir_perms;
allow init nativetest_data_file:file r_file_perms;

allow init kernel:system module_request;
allow init self:capability sys_module;
allow init kernel:capability sys_module;
allow init vendor_file:file r_file_perms;
allow init vendor_file:system { module_load };
allow init system_file:system module_load;

allow init cache_file:dir  { mounton };
allow init asec_apk_file:dir  { mounton };
allow init perfprofd_exec:file  { read open getattr execute };
allow init socket_device:sock_file  { setattr create };
allow init storage_file:dir  { mounton };
allow init block_device:blk_file  { write };
allow init sysfs_devices_system_cpu:file  { create };
allow init configfs:dir  { write add_name remove_name create };
allow init configfs:file  { write create };
allow init configfs:lnk_file  { create unlink };
allow init block_device:chr_file  { getattr ioctl };
allow init userdata_block_device:blk_file { open read write ioctl getattr };
allow init sysfs:file { create };
allow init boot_block_device:lnk_file { relabelto };
allow init sysfs_dm:file { write open };
allow init sysfs_devices_system_cpu:file { write };
allow init file_contexts_file:file read;
allow init shell_exec:file r_file_perms;

recovery_only(`
	allow init rootfs:lnk_file create_file_perms;
	dontaudit init rootfs:file create_file_perms;
')
