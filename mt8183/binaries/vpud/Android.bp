cc_prebuilt_binary {
    name: "vpud.mt8183",
    stem: "vpud", // named vpud on device
    srcs: ["bin/vpud"],
    shared_libs: [
        "libc++",
        "libc",
        "libcutils",
        "libdl",
        "liblog",
        "libm",
        "libutils",
        "libvcodec_utility.mt8183",
        "libvpud_vcodec.mt8183",
    ],
    strip: {
        none: true,
    },
    compile_multilib: "64",
    vendor: true,
    init_rc: ["etc/init.vpud.rc"],
}

cc_prebuilt_library_shared {
    name: "libvcodecdrv.mt8183",
    srcs: ["lib64/libvcodecdrv.so"],
    shared_libs: [
        "libc++",
        "libc",
        "libcutils",
        "libdl",
        "liblog",
        "libm",
        "libutils",
        "libvcodec_utility.mt8183",
    ],
    strip: {
        none: true,
    },
    compile_multilib: "64",
    vendor: true,
}

cc_prebuilt_library_shared {
    name: "libvcodec_utility.mt8183",
    srcs: ["lib64/libvcodec_utility.so"],
    shared_libs: [
        "libc++",
        "libc",
        "libcutils",
        "libdl",
        "liblog",
        "libm",
        "libutils",
    ],
    strip: {
        none: true,
    },
    compile_multilib: "64",
    vendor: true,
}

cc_prebuilt_library_shared {
    name: "libvpud_vcodec.mt8183",
    srcs: ["lib64/libvpud_vcodec.so"],
    shared_libs: [
        "libc++",
        "libc",
        "libcutils",
        "libdl",
        "liblog",
        "libm",
        "libutils",
        "libvcodec_utility.mt8183",
        "libvcodecdrv.mt8183",
    ],
    strip: {
        none: true,
    },
    compile_multilib: "64",
    vendor: true,
}
